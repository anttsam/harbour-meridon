[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-meridon
Exec=harbour-meridon %u
X-DBusActivatable=true
MimeType=text/html;x-scheme-handler/https;
Name=Meridon
# translation example:
# your app name in German locale (de)
#
# Remember to comment out the following line, if you do not want to use
# a different app name in German locale (de).
#Name[de]=harbour-meridon
Categories=Network;

[X-Sailjail]
# Replace with your organization as a reverse domain name
OrganizationName=org.anttsam
# ApplicationName does not have to be identical to Name
ApplicationName=meridon
# Add the required permissions here
Permissions=Internet;Audio;UserDirs;MediaIndexing;RemovableMedia

# With X-DBusActivatable=true the system opens links by calling Open() on
# the org.freedesktop.Application interface of OrganizationName.ApplicationName
# (org.anttsam.meridon, see src/urlrouter.cpp) - sailjaild creates that
# D-Bus service from this line, starting the app if it isn't running.
ExecDBus=harbour-meridon
